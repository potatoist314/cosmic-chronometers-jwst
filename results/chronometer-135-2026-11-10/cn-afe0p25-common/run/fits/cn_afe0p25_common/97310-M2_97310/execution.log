    phot_flux = fit_bands["total_flux_ujy"].to_numpy() * UJY_TO_MAGGIES
    phot_error_stat = fit_bands["total_error_ujy"].to_numpy() * UJY_TO_MAGGIES
if SETTINGS["mock_data"] is not None:
    with np.load(PROJECT_ROOT / SETTINGS["mock_data"]) as mock:
