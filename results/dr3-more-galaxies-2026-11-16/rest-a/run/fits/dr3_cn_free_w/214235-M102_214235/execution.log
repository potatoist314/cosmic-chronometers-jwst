ssp_grid = SETTINGS["ssp_grid"]
try:
    ssp_path = fetch_grid(ssp_grid)
except KeyError:  # local .h5 outside the registry
    ssp_path = Path(ssp_grid).expanduser()
# Grid attr fsps_kwargs_json: zsun_reference 0.0185, log10 Z = [Fe/H] + log10(Zsun).
ssp = SSPDataAfe.load(ssp_path, zsun=0.0185, axis_meaning="feh")
universe_age = float(age_gyr(z_catalog))
# Prospector continuity bins (prospect/models/templates.py adjust_continuity_agebins):
# 0-30 Myr, 30-100 Myr, log-spaced to 0.85 * t_univ, last bin to t_univ.
sfh_tbinmax_yr = universe_age * 0.85 * 1e9
lookback_template = np.array(
    [0.0, 10.0**7.4772 / 1e9]
    + ((10.0 ** np.linspace(8.0, np.log10(sfh_tbinmax_yr), SETTINGS["sfh_nbins"] - 2)) / 1e9).tolist()
    + [universe_age]
)
N_RATIOS = len(lookback_template) - 1
# Evolving metallicity: one logzsol_hist entry per SFH bin, set by the transform below.
logzsol_init = -1.85 - ssp.log10_zsun
metallicity_init = (
    {"logzsol_hist": jnp.full(N_RATIOS, logzsol_init)}
    if SETTINGS["metallicity_evolution"]
    else {"logzsol": jnp.array([logzsol_init])}
)

cn_response = (
    AlfCNResponse.load(PROJECT_ROOT / SETTINGS["abundance_response"], sigma_catalog=sigma_star)
    if SETTINGS["abundance_response"] is not None else None
)
joint_csp = CSPBasis_afe(
    ssp,
    theta={
        "lookback_time": jnp.asarray(lookback_template),
        "sfh": jnp.ones(len(lookback_template)),
        **metallicity_init,
        "afe": jnp.array([float(ssp.ssp_afe[len(ssp.ssp_afe) // 2])]),  # 0.2 on the default grid
        "diffuse_tau_noll": jnp.array([0.1]),
        "diffuse_delta": jnp.array([-0.7]),
    },
    abundance_response=cn_response,
    zh_const=not SETTINGS["metallicity_evolution"],
    sfh_interp="step",
    add_dust=SETTINGS["birth_cloud_dust"],
    add_diffuse_dust=True,
    diffuse_law="noll",
    add_dust_emission=False,
    add_igm=False,
    track_zred_age=False,
    cosmo=Cosmology.planck18(),
    verbose=False,
)


def sfh_from_ratios(free_theta):
    return logsfr_ratios_to_sfh(
        free_theta["logsfr_ratios"], sfh_times_yr=np.asarray(joint_csp.sfh_times)
    )


joint_priors = {name: prior for name, prior in PRIORS.items() if not isinstance(prior, str)}
if cn_response is None:
    joint_priors.pop("cfe")
    joint_priors.pop("nfe")
joint_transforms = {"sfh": sfh_from_ratios}
joint_transforms["diffuse_c_r"] = lambda free_theta: jnp.array([0.0])
if SETTINGS["birth_cloud_dust"]:
    # Birth-cloud optical depth at 5500 A tied to the diffuse one; power-law index fixed at -1.
    joint_transforms["tau_pow"] = lambda free_theta: free_theta["dust_ratio"] * free_theta["diffuse_tau_noll"]
    joint_transforms["alpha_pow"] = lambda free_theta: jnp.array([-1.0])
else:
    joint_priors.pop("dust_ratio")
joint_priors["logzsol"] = Uniform(
    low=float(joint_csp.zmet.min()) + 1e-4, high=float(joint_csp.zmet.max()) - 1e-4
)
if SETTINGS["metallicity_evolution"]:
    # Z(m) = Z_f - (Z_f - Z_0)(1 - m)^alpha over formed-mass fraction m; Z_0 = min(Z_sun / 50, <Z>).
    # [Fe/H] = log10(1/50) - 2.84e-8: the earlier rounded offset 1.7328283, kept for unchanged numbers.
    logz_0_cap = -1.7328283 - np.log10(50.0) - ssp.log10_zsun
    logz_max = float(joint_csp.zmet.max())

    def zh_from_mass(free_theta):
        logz_0 = jnp.minimum(free_theta["logzsol"], logz_0_cap)
        beta = mass_mapped_beta(free_theta["zh_beta_unit"], free_theta["logzsol"], logz_0, logz_max)
        return mass_mapped_zh(
            sfh_from_ratios(free_theta), np.asarray(joint_csp.sfh_times), free_theta["logzsol"], beta, logz_0
        )

    joint_transforms["logzsol_hist"] = zh_from_mass
else:
    joint_priors.pop("zh_beta_unit")
if ssp.n_afe == 1:  # single-plane grid: afe is fixed at its plane, not sampled
    joint_transforms["afe"] = lambda free_theta, _v=float(ssp.ssp_afe[0]): jnp.array([_v])
elif SETTINGS["fix_afe"] is None:
    joint_priors["afe"] = Uniform(low=float(ssp.ssp_afe.min()), high=float(ssp.ssp_afe.max()))
else:  # fixed-alpha comparison: afe is set, not sampled
    joint_transforms["afe"] = lambda free_theta, _v=float(SETTINGS["fix_afe"]): jnp.array([_v])
if "zred" in PRIORS:
    joint_priors["zred"] = Uniform(
        low=z_catalog - SETTINGS["zred_half_width"], high=z_catalog + SETTINGS["zred_half_width"]
    )
if "sigma_smooth" in PRIORS:
    joint_priors["sigma_smooth"] = ClippedNormal(
        mean=sigma_star,
        sigma=sigma_star_err,
        low=sigma_star - SETTINGS["sigma_clip"] * sigma_star_err,
        high=sigma_star + SETTINGS["sigma_clip"] * sigma_star_err,
    )
joint_bounds = {
    name: tuple(float(edge) for edge in prior.bounds)
    for name, prior in joint_priors.items()
    if name != "logsfr_ratios"
}
joint_bounds["logsfr_ratios"] = (-3.0, 3.0)
joint_initial = {
    "logsfr_ratios": jnp.zeros(N_RATIOS),
    "logmass": jnp.array([11.0]),
    "diffuse_delta": jnp.array([-0.7]),
    "log_f_calib": jnp.array([np.log(0.03)]),
}
if cn_response is not None:
    joint_initial.update(cfe=jnp.array([0.0]), nfe=jnp.array([0.0]))
if SETTINGS["birth_cloud_dust"]:
    joint_initial["dust_ratio"] = jnp.array([1.0])
if SETTINGS["metallicity_evolution"]:
    joint_initial.update(logzsol=jnp.array([logzsol_init]), zh_beta_unit=jnp.array([0.5]))
if "zred" in PRIORS:
    joint_initial["zred"] = jnp.array([z_catalog])
if "sigma_smooth" in PRIORS:
    joint_initial["sigma_smooth"] = jnp.array([sigma_star])
joint_model = SedModel(
    joint_csp,
    observations=[phot_obs, spectrum_obs],
    priors=joint_priors,
    transforms=joint_transforms,
    free_param_init=joint_initial,
    zred=z_catalog,
    # stellar dispersion on the spectrum only; the photometry spectrum stays unbroadened
    kinematics=(
        Kinematics(sigma_gal="sigma_smooth", sigma_max=float(joint_priors["sigma_smooth"].bounds[1]))
        if "sigma_smooth" in PRIORS
        else Kinematics(sigma_gal=sigma_star)
    ),
    broaden_photometry=False,
)
initial_photometry = np.asarray(joint_model.predict(joint_model.theta_init)["photometry"])
joint_model.theta_init["logmass"] = joint_model.theta_init["logmass"] + np.median(
    np.log10(phot_flux / initial_photometry)
)
_ = joint_csp.check_param_ranges(joint_model.apply_transforms(joint_model.theta_init))
