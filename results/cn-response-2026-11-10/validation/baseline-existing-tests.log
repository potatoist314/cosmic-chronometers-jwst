        from ceridwen.likelihood import PolynomialCalibration
        from ceridwen.sampler.priors import ClippedNormal, StudentT, Uniform
    
        cells = ["".join(c.get("source", [])) for c in json.loads(NOTEBOOK_PATH.read_text())["cells"]
