SP=$({P} -c "import sysconfig; print(sysconfig.get_paths()[\"purelib\"])") && du -sh $SP/nvidia/nccl/lib $SP/nvidia/nvshmem/lib && mv $SP/nvidia/nccl/lib $SP/nvidia/nccl/lib.hidden && mv $SP/nvidia/nvshmem/lib $SP/nvidia/nvshmem/lib.hidden && ls $SP/nvidia/nccl $SP/nvidia/nvshmem && nvidia-smi --query-gpu=name,driver_version --format=csv
